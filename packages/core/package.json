{
  "name": "@avicola/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/*.test.js\""
  },
  "devDependencies": {
    "@avicola/eslint-config": "workspace:*",
    "@avicola/typescript-config": "workspace:*",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3"
  }
}
